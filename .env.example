# =====================================================================
# 环境变量模板
#
# 使用方法：
#   cp .env.example .env
# 然后按需修改 .env 中的密码（.env 已被 .gitignore 忽略，不会提交）。
# =====================================================================

# ---- MySQL 容器初始化（首次创建数据卷时生效）----
MYSQL_DATABASE=petclinic
MYSQL_USER=petclinic
MYSQL_PASSWORD=change_me_petclinic
MYSQL_ROOT_PASSWORD=change_me_root

# ---- 应用连接串：主机名 mysql 就是 compose 里的服务名 ----
DB_URL=jdbc:mysql://mysql:3306/petclinic?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# ---- 宿主机端口映射（3306/8080 被占用时改这两行即可）----
APP_PORT=8080
MYSQL_PORT=3306
