# =====================================================================
# 环境变量模板（第 06 周 · 微服务版）
#
# 使用方法：
#   cp .env.example .env
# 然后按需修改 .env 中的密码（.env 已被 .gitignore 忽略，不会提交）。
# 注意：数据库账号密码仅在「首次创建数据卷」时由初始化脚本写入 MySQL，
#       之后修改 .env 不会影响已存在的账号（需重建数据卷才生效）。
# =====================================================================

# ---- MySQL root 密码 ----
MYSQL_ROOT_PASSWORD=change_me_root

# ---- 三个服务各自的数据库账号（库 = petclinic_pet / petclinic_doctor / petclinic_appointment）----
PET_DB_USER=pet_user
PET_DB_PASSWORD=pet_pass
DOCTOR_DB_USER=doctor_user
DOCTOR_DB_PASSWORD=doctor_pass
APPOINTMENT_DB_USER=appointment_user
APPOINTMENT_DB_PASSWORD=appointment_pass

# ---- 宿主机端口映射（被占用时改这几行即可；容器内统一是 8080/3306）----
PET_PORT=8084
DOCTOR_PORT=8082
APPOINTMENT_PORT=8083
MYSQL_PORT=3306

# =====================================================================
# Nacos（第 07 周 · 服务注册与发现）
#
# 真实密钥只放本地 .env，本文件是提交到仓库的占位模板
# NACOS_AUTH_TOKEN 必须是 Base64，解码后长度 >= 32 字节（Nacos 硬性要求）
# =====================================================================
NACOS_USERNAME=nacos
NACOS_PASSWORD=change_me_nacos
NACOS_AUTH_TOKEN=请填写Base64编码且解码后不少于32字节的随机串
NACOS_AUTH_IDENTITY_KEY=petclinic-identity
NACOS_AUTH_IDENTITY_VALUE=change_me_identity

# 个人项目专用分组与命名空间（首次使用默认命名空间 public，可留空）
NACOS_GROUP=PERSONAL_GROUP
NACOS_NAMESPACE=

# 三个端口各司其职：控制台 / 服务端 HTTP / SDK gRPC
NACOS_CONSOLE_PORT=18080
NACOS_SERVER_PORT=8848
NACOS_SDK_PORT=9848
