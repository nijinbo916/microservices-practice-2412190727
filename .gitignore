# =====================================================================
# 仓库根目录忽略规则
# =====================================================================

# ---- 本地环境变量：含真实数据库密码，绝不提交 ----
.env
.env.*
!.env.example

# ---- 构建产物 ----
target/
**/target/
*.class

# ---- IDE ----
.idea/
.vscode/
*.iml
*.iws

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log
logs/

# 本地 Maven 种子包（加速镜像构建用，不入库）
services/*/docker/m2-local.tgz

# 本机离线构建覆盖（jar 已在宿主机打好，仅本地验证用，不入库）
compose.override.yaml
services/*/Dockerfile.local
services/*/Dockerfile.local.dockerignore
services/*/docker/app.jar.bin
services/*/docker/app.jar.bin
